<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--上面是头部命名空间-->
<!--mapper开始就是自己定义的了-->
<mapper namespace="com.kjgs.conversation3.mapper.DoneMapper">    <!--对应的mapper类的包路径-->

    <select id = "根据词语查询最新一条" resultType="com.kjgs.conversation3.DoneModel">
        select * from done where 词语 = #{词语} order by id limit 1
    </select>
    <select id = "根据代词指向id查询" resultType="com.kjgs.conversation3.DoneModel">
        select * from done where 代词指向id = #{代词指向id} order by id limit 1
    </select>
    <select id = "根据id查询" resultType="com.kjgs.conversation3.DoneModel">
        select * from done where id = #{id} order by id limit 1
    </select>
    <select id = "查出在句子中的所有词语" resultType="String">
        select distinct 词语 from done where POSITION(词语 IN #{句子})
    </select>
    <insert id="保存" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `conversation`.`done` (
        <if test="pid != null">pid,</if>
        <if test="代词指向id != null">代词指向id,</if>
        <if test="词语 != null and 词语 != ''">词语,</if>
        <if test="处理 != null and 处理 != ''">处理,</if>
        <if test="属性 != null and 属性 != ''">属性,</if>
        <if test="属性值 != null and 属性值 != ''">属性值</if>
        )VALUES(
        <if test="pid != null">#{pid},</if>
        <if test="代词指向id != null">#{代词指向id},</if>
        <if test="词语 != null and 词语 != ''">#{词语},</if>
        <if test="处理 != null and 处理 != ''">#{处理},</if>
        <if test="属性 != null and 属性 != ''">#{属性},</if>
        <if test="属性值 != null and 属性值 != ''">#{属性值}</if>
        )
    </insert>
</mapper>
