<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--上面是头部命名空间-->
<!--mapper开始就是自己定义的了-->
<mapper namespace="com.kjgs.conversation.mysql.mapper.数据Mapper">    <!--对应的mapper类的包路径-->
    <select id = "查询所有数据" resultType="String">
        select id,逻辑 from 逻辑表2
    </select>
    <insert id="保存数据">
        insert into 数据表 (数据) values (#{数据})
    </insert>
</mapper>
